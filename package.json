{
  "name": "social-hub-app",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=3072 ./node_modules/vite/bin/vite.js build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:imports": "node scripts/check-imports.mjs",
    "check:deadcode": "knip --include files,dependencies,unlisted,unresolved --no-config-hints",
    "verify": "npm run lint && npm run check:imports && npm run check:deadcode && npm test && npm run build"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "@ant-design/pro-components": "3.1.12-0",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^6.0.0",
    "dayjs": "^1.11.20",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.1",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^27.0.1",
    "knip": "^6.12.1",
    "vitest": "^4.1.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.1"
  }
}
